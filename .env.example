# ============================================================================
# MORGGY environment example — placeholders only, never commit real values.
#
#  * The browser uses SUPABASE_URL and SUPABASE_ANON_KEY (safe to expose).
#  * The service role key, payment secrets and the CJ API key are for Edge
#    Functions only. Never put them in the storefront or in a committed file.
# ============================================================================

# --- Frontend (assets/js/config.js) ----------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Edge Functions (supabase secrets set ...) -----------------------------
# Supabase provides SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY
# to functions automatically. The values below must be set by you.
PAYSTACK_SECRET_KEY=sk_test_placeholder
PAYSTACK_PUBLIC_KEY=pk_test_placeholder
FLUTTERWAVE_SECRET_HASH=placeholder-verif-hash
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-placeholder

# Public URLs the gateways redirect back to.
PAYMENT_CALLBACK_URL=https://your-site.example/checkout.html?status=returned
PAYMENT_WEBHOOK_BASE_URL=https://your-project-ref.supabase.co/functions/v1

# Origins allowed to call the Edge Functions from a browser (comma separated).
ALLOWED_ORIGINS=http://localhost:8123,https://your-site.example

# --- CJdropshipping --------------------------------------------------------
CJ_API_BASE=https://developers.cjdropshipping.com/api2.0/v1
CJ_API_EMAIL=placeholder@example.com
CJ_API_KEY=placeholder-cj-api-key

# --- Optional --------------------------------------------------------------
SUPPORT_EMAIL=hello@morggy.com
ORDERS_EMAIL=orders@morggy.com
LOG_LEVEL=info
